# Copy to .env.local and fill in. Values come from your Supabase project:
# Dashboard → Project Settings → API (or `npx supabase status` when running locally).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key

# Public site URL, used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the app footer and attached to every analytics event.
NEXT_PUBLIC_APP_VERSION=0.1.0

# Local Supabase only: Google OAuth client for `supabase start`.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
