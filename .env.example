# Copy to .env.local and fill in. Only DATABASE_URL is required to run.

# --- Database (Postgres 15+ with PostGIS) -----------------------------------
# Local:  postgresql://postgres:postgres@localhost:5432/i12farm
# Neon:   use the *pooled* connection string and set DATABASE_PREPARE=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/i12farm
# DATABASE_PREPARE=false     # needed behind a transaction pooler (Neon -pooler, PgBouncer)
# DATABASE_POOL_MAX=5        # 1 on serverless hosts (Vercel), 5-10 on a VPS

# --- Site ---------------------------------------------------------------------
# Public URL: used in sign-in links, Google redirect and M-Pesa callbacks.
# Cookies are marked Secure when this starts with https://.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.3.0

# --- Photos -------------------------------------------------------------------
# Default: files on local disk under ./data/media, served at /media.
# MEDIA_DIR=/var/lib/i12farm/media
# On hosts without a lasting disk use an S3-compatible bucket (Cloudflare R2: 10 GB free):
# MEDIA_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=i12farm-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# NEXT_PUBLIC_MEDIA_URL=https://media.example.com   # the bucket's public URL

# --- Google Maps (optional) ------------------------------------------------------
# Without a key the app uses free OpenStreetMap-based maps (OpenFreeMap). With a
# key it uses Google Maps and falls back to the free maps if Google can't load.
# Google Cloud console → APIs & Services → enable "Maps JavaScript API" →
# Credentials → API key. Restrict it to "Websites" (your domain, plus
# http://localhost:3000/* for development) and to the Maps JavaScript API only.
# A billing account must be attached even for the free monthly usage.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for the farm pins (Maps → Map management → Create, JavaScript, Vector).
# Without it Google's DEMO_MAP_ID is used, which is fine for testing.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Both are baked into the browser bundle at build time: rebuild after changing them.

# --- Email (optional: sign-in links) -----------------------------------------
# Without it, links are printed in the server log (and shown on screen in dev).
# SMTP_URL=smtps://USER:PASSWORD@smtp-relay.brevo.com:465
# MAIL_FROM=i12farm <no-reply@your-domain>

# --- Google sign-in (optional) -----------------------------------------------
# Google Cloud console → Credentials → OAuth client (Web).
# Redirect URI: <NEXT_PUBLIC_SITE_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Demo mode ------------------------------------------------------------------
# Simulated M-Pesa payments, and a payment callback URL that works without a secret.
# Always on with `npm run dev`. In a production build (`npm start`) it is OFF
# unless you set DEMO_MODE=true on purpose, e.g. for a public demo; a banner
# then tells visitors nothing is real. Never set it on the real pilot.
# DEMO_MODE=true

# --- Payments: Pesi Pay by Switchlink -----------------------------------------
# Buyers approve an M-Pesa prompt sent through Pesi; payouts and refunds go out
# through Pesi too. Switchlink gives a client id, client secret and encryption
# key per environment when it onboards you.
# simulate (default without keys) | sandbox (Pesi's SIT gateway) | production
PESI_ENV=simulate
# PESI_CLIENT_ID=
# PESI_CLIENT_SECRET=
# PESI_ENCRYPTION_KEY=                         # 64 hex characters, from Switchlink
# PESI_ACCOUNT_REFERENCE=                      # Pesi account that receives collections (clientAccountReference)
# PESI_SOURCE_ACCOUNT=                         # Pesi account payouts are paid from (sourceAccount, e.g. MCA…)
# PESI_CALLBACK_SECRET=                        # 24+ random characters: openssl rand -hex 24
# PESI_CALLBACK_BASE_URL=                      # defaults to NEXT_PUBLIC_SITE_URL; must be public https
# PESI_BASE_URL=                               # only to point at a stand-in (scripts/pesi-mock.mjs)
# The callback URL can be registered with Pesi ONCE per account; register it only
# after the final domain is live: node scripts/pesi-register-callback.mjs --yes

# --- Scheduled upkeep (optional) ----------------------------------------------
# Lets a scheduler call /api/cron/maintenance with "Authorization: Bearer <secret>".
# The nightly GitHub workflow does the same without it.
# CRON_SECRET=                                 # 24+ random characters: openssl rand -hex 24
