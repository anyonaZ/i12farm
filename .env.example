# Copy to .env.local and fill in. Only DATABASE_URL is required to run.

# --- Database (Postgres 15+ with PostGIS) -----------------------------------
# Local:  postgresql://postgres:postgres@localhost:5432/i12farm
# Neon:   use the *pooled* connection string and set DATABASE_PREPARE=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/i12farm
# DATABASE_PREPARE=false     # needed behind a transaction pooler (Neon -pooler, PgBouncer)
# DATABASE_POOL_MAX=5        # 1 on serverless hosts (Vercel), 5-10 on a VPS

# --- Site ---------------------------------------------------------------------
# Public URL: used in sign-in links, Google redirect and M-Pesa callbacks.
# Cookies are marked Secure when this starts with https://.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.3.0

# --- Photos -------------------------------------------------------------------
# Default: files on local disk under ./data/media, served at /media.
# MEDIA_DIR=/var/lib/i12farm/media
# On hosts without a lasting disk use an S3-compatible bucket (Cloudflare R2: 10 GB free):
# MEDIA_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=i12farm-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# NEXT_PUBLIC_MEDIA_URL=https://media.example.com   # the bucket's public URL

# --- Email (optional: sign-in links) -----------------------------------------
# Without it, links are printed in the server log (and shown on screen in dev).
# SMTP_URL=smtps://USER:PASSWORD@smtp-relay.brevo.com:465
# MAIL_FROM=i12farm <no-reply@your-domain>

# --- Google sign-in (optional) -----------------------------------------------
# Google Cloud console → Credentials → OAuth client (Web).
# Redirect URI: <NEXT_PUBLIC_SITE_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- M-Pesa (Daraja) ----------------------------------------------------------
# simulate (default without keys) | sandbox | production
MPESA_ENV=simulate
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379                       # sandbox paybill; your paybill or store number live
# MPESA_PASSKEY=                               # sandbox passkey from the Daraja portal
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline # or CustomerBuyGoodsOnline for a till
# MPESA_PARTY_B=                               # till number when using Buy Goods
# MPESA_CALLBACK_SECRET=                       # 24+ random characters: openssl rand -hex 24
# MPESA_CALLBACK_BASE_URL=                     # defaults to NEXT_PUBLIC_SITE_URL; must be public https
