{
  "name": "i12farm",
  "version": "0.4.0",
  "private": true,
  "description": "Pinned, discoverable farm pages and orders for every Kenyan farmer.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:reset": "node scripts/db.mjs reset",
    "db:test": "scripts/test-db.sh",
    "pesi:mock": "node scripts/pesi-mock.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:status": "node scripts/db.mjs status",
    "db:seed": "node scripts/db.mjs seed",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "predev": "node scripts/copy-map-worker.mjs",
    "prebuild": "node scripts/copy-map-worker.mjs"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "aws4fetch": "^1.0.20",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.5",
    "next-intl": "^4.3.0",
    "nodemailer": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/google.maps": "^3.66.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
