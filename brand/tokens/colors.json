{
  "name": "i12farm brand colours",
  "core": {
    "emerald":    { "hex": "#047857", "rgb": [4, 120, 87],    "cmyk": [97, 0, 27, 53], "use": "Logo, headings, rules, buttons, links" },
    "forest-ink": { "hex": "#0A1F16", "rgb": [10, 31, 22],    "cmyk": [68, 0, 29, 88], "use": "Body text, table headers, dark panels" },
    "lime":       { "hex": "#C6F36B", "rgb": [198, 243, 107], "cmyk": [19, 0, 56, 5],  "use": "Highlights on Ink or Emerald only, never text on white" },
    "mint-mist":  { "hex": "#F5F8F6", "rgb": [245, 248, 246], "cmyk": [1, 0, 1, 3],    "use": "Page tint, callouts, table stripes" }
  },
  "support": {
    "sprout":        { "hex": "#10B981", "rgb": [16, 185, 129], "cmyk": [91, 0, 30, 27], "use": "Logo and icons on dark, graphics" },
    "harvest-amber": { "hex": "#F59E0B", "rgb": [245, 158, 11], "cmyk": [0, 36, 96, 4],  "use": "Prices, warnings, second chart series" },
    "soil":          { "hex": "#56645D", "rgb": [86, 100, 93],  "cmyk": [14, 0, 7, 61],  "use": "Secondary text" },
    "line":          { "hex": "#E1E9E4", "rgb": [225, 233, 228], "cmyk": [3, 0, 2, 9],   "use": "Borders and dividers" }
  },
  "chart": ["#047857", "#4A8FC9", "#F59E0B", "#9AA8A1"],
  "fonts": { "heading": "Outfit", "body": "Inter", "fallback": "Arial" },
  "note": "CMYK values are a starting point. Ask the printer for a proof before a large run."
}
